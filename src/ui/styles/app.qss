/* ==========================================
   VENTANA PRINCIPAL
   ========================================== */

QMainWindow {
    background-color: #00008B;
}


/* ==========================================
   TÍTULO PRINCIPAL
   ========================================== */

QLabel#title {
    font-size: 28px;
    font-weight: bold;
    color: #DAA520;
    padding-top: 15px;
}


/* ==========================================
   SUBTÍTULO
   ========================================== */

QLabel#subtitle {
    font-size: 14px;
    color: #F8F8FF;
    padding-bottom: 15px;
}


/* ==========================================
   CONTENEDORES / GRUPOS
   ========================================== */

QGroupBox {
    background-color: #2F4F4F;
    border: 1px solid #DAA520;
    border-radius: 8px;
    margin-top: 10px;
    padding: 15px;
    font-size: 15px;
    font-weight: bold;
}


/* ==========================================
   TÍTULO DE LOS GRUPOS
   ========================================== */

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}


/* ==========================================
   CAMPOS DE ENTRADA
   ========================================== */

QLineEdit {
    background-color: #f9fafb;
    color: #000000;
    border: 2px solid #DAA520;
    border-radius: 6px;
    padding: 8px;
    font-size: 14px;
}


/* ==========================================
   CAMPO DE ENTRADA SELECCIONADO
   ========================================== */

QLineEdit:focus {
    border: 1px solid #DAA520;
}


/* ==========================================
   BOTÓN PRINCIPAL
   ========================================== */

QPushButton {
    background-color: #DAA520;
    color: white;
    padding: 12px;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    font-size: 14px;
}


/* ==========================================
   BOTÓN AL PASAR EL MOUSE
   ========================================== */

QPushButton:hover {
    background-color: #1d4ed8;
}

/* ==========================================
   DESCRIPCIONES
   ========================================== */

QLabel#description {
    color: #F8F8FF;
    font-size: 16px;
    padding: 10px;
}


/* ==========================================
   ÁREA EDUCATIVA
   ========================================== */

QTextEdit {
    background-color: #f9fafb;
    color: #111827;
    border: 2px solid #DAA520;
    border-radius: 8px;
    padding: 15px;
    font-size: 14px;
}


/* ==========================================
   BOTONES DEL MENÚ
   ========================================== */

QPushButton {
    background-color: #DAA520;
    color: white;
    padding: 15px;
    border: none;
    border-radius: 8px;
    font-weight: bold;
    font-size: 15px;
}

QPushButton:hover {
    background-color: #1d4ed8;
}

QPushButton:pressed {
    background-color: #163da8;
}